# ---------------------------------------------------------------------------
# ResearchPaper Agent - environment variables
# Copy to `.env` and fill in. NEVER commit real keys.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
# Public base URL of the Next.js control plane
NEXT_PUBLIC_APP_URL=http://localhost:3000
# URL the browser/SSE client uses to reach the control plane API
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# --- Database ---------------------------------------------------------------
# Local development (zero infra): SQLite
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL / Supabase):
# DATABASE_URL="postgresql://user:password@host:5432/researchpaper?schema=public"

# --- Authentication ---------------------------------------------------------
# Secret used to sign session cookies (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Optional: allow anonymous local development without login
ALLOW_ANONYMOUS_DEV_USER=true

# --- LLM providers (at least one, or use mock for offline development) ------
# LLM_PROVIDER: openai | anthropic | gemini | mock
LLM_PROVIDER=mock
LLM_MODEL=
LLM_MAX_OUTPUT_TOKENS=8000
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=3

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

# --- Literature APIs --------------------------------------------------------
# Crossref politely asks for a contact e-mail in the User-Agent / mailto param
CROSSREF_EMAIL=
CROSSREF_BASE_URL=https://api.crossref.org
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
OPENALEX_EMAIL=
OPENALEX_BASE_URL=https://api.openalex.org
ARXIV_BASE_URL=http://export.arxiv.org/api/query
# Comma-separated list, first entry wins
LITERATURE_PROVIDERS=openalex,crossref,arxiv,semantic_scholar
LITERATURE_CACHE_TTL_HOURS=168

# --- Storage ----------------------------------------------------------------
# STORAGE_DRIVER: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.storage
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=900

# --- Queue / background jobs ------------------------------------------------
# QUEUE_DRIVER: db | redis
QUEUE_DRIVER=db
QUEUE_POLL_INTERVAL_MS=2000
REDIS_URL=
QUEUE_NAME=researchpaper-jobs

# --- Python AI/DOCX worker service -----------------------------------------
BACKEND_URL=http://127.0.0.1:8000
# Shared secret for control-plane <-> worker authentication (>= 16 chars)
WORKER_SHARED_SECRET=dev-worker-secret-change-me
BACKEND_REQUEST_TIMEOUT_MS=1800000

# --- Ingestion limits -------------------------------------------------------
MAX_FILE_SIZE_MB=64
MAX_FILES_PER_PROJECT=60
ALLOWED_FILE_EXTENSIONS=.ipynb,.py,.csv,.xlsx,.xls,.json,.pdf,.docx,.txt,.md,.png,.jpg,.jpeg

# --- Job limits / cost control ---------------------------------------------
JOB_MAX_ATTEMPTS=3
JOB_STAGE_TIMEOUT_MS=600000
DOCX_MAX_REVISION_ITERATIONS=3
