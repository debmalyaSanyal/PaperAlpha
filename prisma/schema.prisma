// ---------------------------------------------------------------------------
// ResearchPaper Agent - data model
//
// Targets SQLite for zero-infrastructure local development. For production
// (PostgreSQL / Supabase) change `provider` to "postgresql" and regenerate.
// Enum-like fields are modelled as String on purpose so the identical schema
// works on both engines; allowed values are enforced by Zod (lib/schemas) and
// Pydantic (backend/app/schemas.py).
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
  // Netlify builds run on Ubuntu but functions execute on AWS Lambda
  // (rhel-openssl-3.0.x). Without this, `prisma generate` only emits the
  // build-machine engine and every query fails at runtime with
  // "Query engine library for current platform could not be found".
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         String   @default("user") // user | admin
  isDevUser    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects Project[]

  @@map("users")
}

model Project {
  id     String @id @default(cuid())
  userId String

  title      String
  topic      String
  problem    String
  objectives String?
  questions  String?
  notes      String?

  // Paper configuration
  paperFormat   String  @default("IEEE") // IEEE|Springer|Elsevier|ACM|APA|Nature|Custom
  customFormat  String?
  /// Structured custom-format patch (JSON text) validated by lib/formats/schema.ts
  customFormatPatch String?
  citationStyle String  @default("IEEE") // IEEE|APA|Vancouver|Harvard|Chicago|MLA|Custom
  language      String  @default("English")
  targetPages   Int     @default(8)
  targetWords   Int?
  additionalInstructions String?

  // Lifecycle
  status       String  @default("CREATED")
  statusDetail String?
  progress     Int     @default(0)
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  researchInput     ResearchInput?
  files             UploadedFile[]
  codeAnalyses      CodeAnalysis[]
  datasetAnalyses   DatasetAnalysis[]
  literatureSources LiteratureSource[]
  literatureReviews LiteratureReview[]
  experiments       Experiment[]
  outlines          PaperOutline[]
  sections          PaperSection[]
  citations         Citation[]
  figures           Figure[]
  tables            TableRecord[]
  versions          PaperVersion[]
  jobs              GenerationJob[]
  qualityReports    QualityReport[]
  documents         Document[]
  artifacts         Artifact[]
  validation        ResearchValidation?

  @@index([userId, status])
  @@map("projects")
}

model ResearchInput {
  id        String @id @default(cuid())
  projectId String @unique

  topic      String
  problem    String
  objectives String?
  questions  String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("research_inputs")
}

// ---------------------------------------------------------------------------
// Files & ingestion
// ---------------------------------------------------------------------------

model UploadedFile {
  id        String @id @default(cuid())
  projectId String

  originalName String
  storedName   String
  storageKey   String
  mimeType     String
  extension    String
  sizeBytes    Int
  checksum     String

  category   String  @default("unknown") // notebook|python|dataset|document|image|other
  status     String  @default("UPLOADED") // UPLOADED|PARSED|FAILED
  parseError String?

  /// Normalized extraction result (JSON string) produced by the ingestion agent
  extractedJson String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, checksum])
  @@index([projectId, category])
  @@map("uploaded_files")
}

// ---------------------------------------------------------------------------
// Analysis
// ---------------------------------------------------------------------------

model CodeAnalysis {
  id        String @id @default(cuid())
  projectId String

  language           String?
  frameworks         String? // JSON string[]
  libraries          String? // JSON string[]
  datasets           String? // JSON string[]
  preprocessing      String?
  featureEngineering String?
  modelArchitecture  String?
  layers             String? // JSON
  lossFunction       String?
  optimizer          String?
  learningRate       String?
  batchSize          String?
  epochs             String?
  dataSplit          String?
  augmentation       String?
  regularization     String?
  metrics            String? // JSON string[]
  baselines          String? // JSON string[]
  hyperparameters    String? // JSON object
  randomSeeds        String?
  hardware           String?
  trainingProcedure  String?
  entryPoints        String? // JSON string[]
  raw                String? // full structured payload

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("code_analyses")
}

model DatasetAnalysis {
  id        String @id @default(cuid())
  projectId String
  fileId    String?

  name              String
  rows              Int?
  columns           Int?
  columnNames       String? // JSON string[]
  dtypes            String? // JSON object
  missingValues     String? // JSON object
  descriptiveStats  String? // JSON object
  classDistribution String? // JSON object
  sampleRows        String? // JSON array
  notes             String?

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("dataset_analyses")
}

// ---------------------------------------------------------------------------
// Literature
// ---------------------------------------------------------------------------

model LiteratureSource {
  id        String @id @default(cuid())
  projectId String

  citationKey     String // REF001 ...
  title           String
  authors         String? // JSON string[]
  year            Int?
  venue           String?
  doi             String?
  url             String?
  abstract        String?
  source          String // openalex|crossref|arxiv|semantic_scholar|pubmed|user
  sourceId        String?
  relevance       String?
  keyMethod       String?
  keyResult       String?
  limitation      String?
  usedDataset     String?
  usedMetric      String?
  verified        Boolean @default(false)
  verificationNote String?
  theme           String? // thematic bucket used by the synthesis agent
  isFoundational  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  citations Citation[]

  @@unique([projectId, citationKey])
  @@index([projectId, theme])
  @@map("literature_sources")
}

model LiteratureReview {
  id        String @id @default(cuid())
  projectId String @unique

  themesJson     String // JSON: [{ theme, summary, sourceKeys[] }]
  synthesis      String?
  researchGap    String?
  matrixJson     String? // literature comparison matrix rows
  queryLog       String? // JSON: executed queries + providers
  providerCounts String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("literature_reviews")
}

// ---------------------------------------------------------------------------
// Experiments & results
// ---------------------------------------------------------------------------

model Experiment {
  id        String @id @default(cuid())
  projectId String

  name          String
  description   String?
  kind          String  @default("main") // main|ablation|baseline|hyperparameter_search
  configuration String? // JSON object
  isSuggested   Boolean @default(false) // true => "Suggested future experiment"
  evidence      String? // JSON string[] of source locations
  orderIndex    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results ExperimentResult[]

  @@index([projectId, kind])
  @@map("experiments")
}

model ExperimentResult {
  id           String @id @default(cuid())
  experimentId String
  projectId    String

  metricName  String
  metricValue Float?
  metricText  String? // non-numeric values, e.g. "0.92 +/- 0.01"
  split       String? // train|val|test|cv
  stdDev      Float?
  n           Int?
  isAvailable Boolean @default(true)
  evidence    String?

  createdAt DateTime @default(now())

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([experimentId, metricName])
  @@map("experiment_results")
}

// ---------------------------------------------------------------------------
// Paper structure & content
// ---------------------------------------------------------------------------

model PaperOutline {
  id        String @id @default(cuid())
  projectId String

  formatName    String
  version       Int     @default(1)
  isActive      Boolean @default(true)
  structureJson String // JSON: nested sections w/ order, kind, word budget
  wordBudget    String? // JSON: per-section word allocation
  notes         String?

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, isActive])
  @@map("paper_outlines")
}

model PaperSection {
  id        String @id @default(cuid())
  projectId String

  key          String // stable identifier, e.g. "methodology"
  title        String
  headingLevel Int     @default(1)
  orderIndex   Int
  numberLabel  String? // "III" for IEEE, "3" for Springer

  content       String?
  contentHtml   String?
  wordCount     Int     @default(0)
  targetWords   Int?
  status        String  @default("PENDING") // PENDING|GENERATING|DRAFT|VERIFIED|FAILED
  isUserEdited  Boolean @default(false)
  generatedBy   String? // prompt key used
  citationsUsed String? // JSON string[] of citation keys
  claimsJson    String? // claim-verification results
  revision      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([projectId, orderIndex])
  @@map("paper_sections")
}

model Citation {
  id        String @id @default(cuid())
  projectId String
  sourceId  String?

  citationKey       String // REF001
  raw               String? // formatted reference text for the target style
  style             String  @default("IEEE")
  orderIndex        Int     @default(0)
  inTextCount       Int     @default(0)
  isOrphanReference Boolean @default(false) // listed but never cited
  isMissingSource   Boolean @default(false) // cited but absent from reference list

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source  LiteratureSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([projectId, citationKey])
  @@index([projectId, orderIndex])
  @@map("citations")
}

model Figure {
  id        String @id @default(cuid())
  projectId String
  fileId    String?

  label       String // "Figure 1"
  number      Int
  caption     String
  storageKey  String?
  source      String  @default("notebook_output") // notebook_output|uploaded|generated|external
  widthInches Float?
  placement   String?

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
  @@map("figures")
}

model TableRecord {
  id        String @id @default(cuid())
  projectId String
  fileId    String?

  label       String // "Table 1"
  number      Int
  caption     String
  headersJson String // JSON string[]
  rowsJson    String // JSON string[][]
  source      String  @default("notebook_output") // notebook_output|uploaded|generated
  isSuggested Boolean @default(false) // suggested tables never present measured numbers
  notes       String?

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
  @@map("tables")
}

// ---------------------------------------------------------------------------
// Outputs
// ---------------------------------------------------------------------------

model PaperVersion {
  id        String @id @default(cuid())
  projectId String

  version      Int
  kind         String  @default("generated") // generated|user_edit|revision|final
  snapshotJson String // full paper snapshot (title/abstract/sections/refs/...)
  pageEstimate Float?
  wordCount    Int?
  createdBy    String?
  note         String?

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId])
  @@map("paper_versions")
}

model Document {
  id        String @id @default(cuid())
  projectId String

  format     String  @default("docx")
  storageKey String
  fileName   String
  sizeBytes  Int
  pageCount  Float?
  wordCount  Int?
  isFinal    Boolean @default(false)
  metaJson   String?

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("documents")
}

/// Human review checklist (section 48) - download is gated on this.
model ResearchValidation {
  id        String @id @default(cuid())
  projectId String @unique

  verifiedResults     Boolean  @default(false)
  verifiedReferences  Boolean  @default(false)
  verifiedMethodology Boolean  @default(false)
  reviewedAiContent   Boolean  @default(false)
  verifiedCompliance  Boolean  @default(false)
  confirmedAt         DateTime?

  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("research_validations")
}

// ---------------------------------------------------------------------------
// Jobs, observability, agent state
// ---------------------------------------------------------------------------

model GenerationJob {
  id        String @id @default(cuid())
  projectId String

  type        String  @default("full_pipeline")
  status      String  @default("QUEUED") // QUEUED|RUNNING|SUCCEEDED|FAILED|CANCELLED
  stage       String?
  progress    Int     @default(0)
  attempts    Int     @default(0)
  maxAttempts Int     @default(3)
  payloadJson String?
  resultJson  String?
  errorMessage String?
  startedAt   DateTime?
  finishedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logs    JobLog[]

  @@index([status, createdAt])
  @@index([projectId])
  @@map("generation_jobs")
}

model JobLog {
  id        String  @id @default(cuid())
  jobId     String
  projectId String?

  level      String  @default("info") // debug|info|warn|error
  stage      String?
  agent      String?
  message    String
  metaJson   String?
  tokensIn   Int?
  tokensOut  Int?
  durationMs Int?

  createdAt DateTime @default(now())

  job GenerationJob? @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@map("job_logs")
}

/// Resumable per-stage agent state - the DB-backed equivalent of the
/// /project/{stage}/ artifact folders described in the specification.
model Artifact {
  id        String @id @default(cuid())
  projectId String
  jobId     String?

  stage         String // ingestion|code_analysis|research_understanding|literature|...
  key           String // artifact name, e.g. "summary"
  payload       String // JSON
  schemaVersion Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, stage, key])
  @@index([projectId, stage])
  @@map("artifacts")
}

model QualityReport {
  id        String @id @default(cuid())
  projectId String
  versionId String?

  scoreJson            String // JSON object of sub-scores
  issuesJson           String?
  warningsJson         String?
  citationIssuesJson   String?
  technicalIssuesJson  String?
  formattingIssuesJson String?
  pageEstimate         Float?
  wordCount            Int?
  verdict              String  @default("pass") // pass|pass_with_warnings|fail

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("quality_reports")
}

model LlmCall {
  id        String @id @default(cuid())
  projectId String?
  jobId     String?

  provider  String
  model     String
  promptKey String?
  tokensIn  Int     @default(0)
  tokensOut Int     @default(0)
  costUsd   Float   @default(0)
  latencyMs Int     @default(0)
  ok        Boolean @default(true)
  error     String?
  cacheHit  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("llm_calls")
}
