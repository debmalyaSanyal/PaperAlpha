  },
  "references": { "headingText": "REFERENCES", "headingNumbered": false, "fontSize": 8, "hangingIndentInches": 0.25, "sortOrder": "citation_order", "labelFormat": "[{n}]", "style": "ACM" },
  "figures": { "captionPosition": "below", "labelFormat": "Figure {n}.", "fontSize": 8, "centered": true, "maxWidthInches": 3.3 },
  "tables": { "captionPosition": "above", "labelFormat": "Table {n}.", "fontSize": 8, "centered": true, "borderStyle": "acm", "captionBold": false, "captionItalic": false },
  "equations": { "numbering": "parenthesized_right", "numberLabelFormat": "({n})" },
