  },
  "title": { "fontSize": 18, "bold": true, "alignment": "left", "textCase": "title_case" },
  "authors": { "fontSize": 11, "alignment": "left", "includeAffiliations": true },
  "abstract": {
    "headingText": "ABSTRACT",
    "headingNumbered": false,
    "headingBold": true,
    "headingItalic": false,
    "bodyBold": false,
    "fontSize": 9,
    "justify": true,
