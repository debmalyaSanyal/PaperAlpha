  "description": "Elsevier journal style (e.g. Applied Soft Computing / Expert Systems with Applications): A4, single column, 10pt Times New Roman, numbered headings, Vancouver-style numbered citations.",
  "page": { "size": "A4", "widthInches": 8.27, "heightInches": 11.69, "columns": 1, "columnSpacingInches": 0.25 },
