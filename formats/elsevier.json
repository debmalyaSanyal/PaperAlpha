  },
  "keywords": { "headingText": "Keywords", "headingInSameParagraph": true, "headingItalic": false, "headingBold": true, "separator": "; ", "maxCount": 6 },
  "headings": {
    "numberingEnabled": true,
    "level1": { "fontSize": 12, "bold": true, "italic": false, "alignment": "left", "numbering": "arabic", "numberSeparator": ". ", "spacingBeforePt": 14, "spacingAfterPt": 6 },
    "level2": { "fontSize": 11, "bold": true, "italic": false, "alignment": "left", "numbering": "arabic_dotted", "numberSeparator": " ", "spacingBeforePt": 10, "spacingAfterPt": 4 },
    "level3": { "fontSize": 10, "bold": false, "italic": true, "alignment": "left", "numbering": "arabic_dotted", "numberSeparator": " ", "spacingBeforePt": 8, "spacingAfterPt": 4 }
  },
  "references": { "headingText": "References", "headingNumbered": false, "fontSize": 9, "hangingIndentInches": 0.25, "sortOrder": "citation_order", "labelFormat": "{n}.", "style": "Vancouver" },
  "figures": { "captionPosition": "below", "labelFormat": "Fig. {n}.", "fontSize": 9, "centered": true, "maxWidthInches": 5.8 },
  "tables": { "captionPosition": "above", "labelFormat": "Table {n}.", "fontSize": 9, "centered": true, "borderStyle": "booktabs", "captionBold": false, "captionItalic": false },
  "equations": { "numbering": "parenthesized_right", "numberLabelFormat": "({n})" },
