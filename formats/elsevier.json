    "firstLineIndentInches": 0.0
  },
  "title": { "fontSize": 16, "bold": true, "alignment": "left", "textCase": "sentence_case" },
  "authors": { "fontSize": 11, "alignment": "left", "includeAffiliations": true },
  "abstract": {
    "headingText": "Abstract",
    "headingNumbered": false,
    "headingBold": true,
    "headingItalic": false,
    "bodyBold": false,
    "fontSize": 10,
    "justify": true,
